# Optional. Copy to .env only if you want to change the defaults:
#   cp .env.example .env
# Everything the application itself needs - account, TMDB API key, languages,
# schedule - is asked for by the setup wizard on first start and stored in
# /config. The .env is ignored by git.

# Host port. Inside the container the application listens on 8081.
HOST_PORT=8099

# Folder holding the movies, on the host. Must be writable.
MOVIES_PATH=/mnt/user/Movies

# Where the database, the session key and the webhook token are kept.
CONFIG_PATH=./config

TZ=Europe/Vienna

# Ownership of files written by the container. On Unraid: 99/100 (nobody/users).
PUID=99
PGID=100
