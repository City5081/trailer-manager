# Vorlage: als .env kopieren und ausfuellen.
#   cp .env.example .env
# Die .env gehoert nicht ins Repository - sie steht in der .gitignore.

# --- Zugang zur Weboberflaeche ------------------------------------------
WEB_USERNAME=admin
WEB_PASSWORD=bitte-aendern
# Sicherer als WEB_PASSWORD; erzeugen mit: python3 tools/hash_password.py
# Ist beides gesetzt, gilt der Hash.
WEB_PASSWORD_HASH=
# Sitzungsschluessel. Leer lassen: wird dann einmalig unter /config abgelegt.
SECRET_KEY=
# Nur setzen, wenn eine Gegenstelle (z. B. Authelia) die Anmeldung uebernimmt.
AUTH_DISABLED=false
# Hinter einem Reverse Proxy mit TLS auf true setzen.
COOKIE_SECURE=false
SESSION_DAYS=30

# --- TMDB ----------------------------------------------------------------
# v3-API-Key von themoviedb.org, nicht das Read-Access-Token.
TMDB_API_KEY=
# "de" = ausschliesslich deutsche Trailer, "de,en" mit Rueckfall auf Englisch.
LANGUAGES=de

# --- Verhalten -----------------------------------------------------------
# emby | kodi | url
LINK_FORMAT=emby
# Vorhandene Schreibweise beibehalten, statt sie auf LINK_FORMAT umzustellen.
KEEP_FORMAT=true
# Vor der ersten Aenderung eine .nfo.bak anlegen.
BACKUP=true
# 0 schaltet den Zeitplan ab.
SCAN_INTERVAL_HOURS=12
SCAN_ON_START=true
# Erfolglose Filme nach so vielen Tagen erneut pruefen.
RECHECK_DAYS=30
# de | en
UI_LANGUAGE=de

# --- Webhook (Emby / Jellyfin / Jellyseerr) ------------------------------
# Leer lassen: beim ersten Start wird ein Token erzeugt und unter
# /config/webhook_token abgelegt. Die fertige Webhook-Adresse steht dann in der
# Oberflaeche unter Einstellungen -> Webhook. Nur ausfuellen, wenn du ein
# bestimmtes Token brauchst.
WEBHOOK_TOKEN=

# --- Container -----------------------------------------------------------
TZ=Europe/Vienna
# Port auf dem Host (im Container lauscht die Anwendung auf 8081)
HOST_PORT=8099
# Ordner mit den Filmen auf dem Host - muss beschreibbar sein.
# (Im Container heisst er /movies; diese Variable steuert nur, was compose
#  dorthin einhaengt - deshalb nicht MOVIES_DIR nennen.)
MOVIES_PATH=/mnt/user/Filme
# Ablage fuer Datenbank und Einstellungen auf dem Host
CONFIG_PATH=./config
# Rechte fuer geschriebene Dateien; auf Unraid 99/100 (nobody/users)
PUID=99
PGID=100
